# Copie para .env e preencha. O .env nunca vai para o Git.
# Gere a senha com: openssl rand -base64 24
POSTGRES_DB=pitaco
POSTGRES_USER=pitaco
POSTGRES_PASSWORD=

# Backup (serviço backup do compose.yaml). Destino no formato do rclone: o remoto
# pitacobackup, definido pelas variáveis RCLONE_CONFIG_PITACOBACKUP_* abaixo, seguido
# de bucket/prefixo. Exemplo: pitacobackup:meu-bucket/pitaco
BACKUP_REMOTE=
# Cópias mantidas no destino e intervalo entre backups, em segundos.
BACKUP_KEEP=14
BACKUP_INTERVAL=86400
# S3 e compatíveis. PROVIDER: AWS, Cloudflare, Backblaze (via S3), Minio ou Other.
RCLONE_CONFIG_PITACOBACKUP_TYPE=s3
RCLONE_CONFIG_PITACOBACKUP_PROVIDER=Other
RCLONE_CONFIG_PITACOBACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_PITACOBACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_PITACOBACKUP_ENDPOINT=
RCLONE_CONFIG_PITACOBACKUP_REGION=

# Swagger UI e /v3/api-docs na API. Desligados por padrão em produção.
# PITACO_API_DOCS_ENABLED=true
