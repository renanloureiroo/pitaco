<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mantém o console exatamente como o Spring Boot o entrega (mesmo padrão, mesmas
  cores, mesmo traceId no MDC) e acrescenta um segundo destino: o appender do
  OpenTelemetry, que leva o log para o Loki via OTLP.

  Os níveis continuam vindo de logging.level.* no application.yml — o Spring os
  aplica depois de ler este arquivo.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
    <!-- Leva o MDC junto: é o que carrega traceId e spanId para o Loki e
         permite pular de um trace no Tempo para os logs daquela requisição. -->
    <captureMdcAttributes>*</captureMdcAttributes>
    <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
    <captureLoggerContext>true</captureLoggerContext>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="OTEL"/>
  </root>
</configuration>
